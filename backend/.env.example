# Copy this file to `.env` (same folder) and fill in your own values.
# .env is already in .gitignore - never commit real credentials.

# --- Database ---
# Leave unset to use backend/data/codetrack.db
# DATABASE_PATH=/absolute/path/to/codetrack.db
SQL_ECHO=false

# --- Platform usernames ---
CODEFORCES_USERNAME=tourist
LEETCODE_USERNAME=
CODECHEF_USERNAME=

# --- LeetCode auth (optional, only needed for full solve-history sync) ---
# See docs/leetcode.md for how to obtain these from your browser cookies.
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=

# --- App ---
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
